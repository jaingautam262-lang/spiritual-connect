  getJainPathshalaEntriesByCategory: (category: text) ->
   (vec JainPathshalaEntry) query;
  /// Authenticated users can retrieve a single kundali match by id (only their own).
  getKundaliMatchById: (id: text) -> (opt KundaliMatch) query;
  /// Authenticated users can retrieve all their own kundali match results, sorted newest first.
  getKundaliMatches: () -> (vec KundaliMatch) query;
