  /// Admin-only: list all user profiles.
  getAllUserProfiles: () -> (vec record {
                                   principal;
                                   UserProfile;
                                 }) query;
  /// Public: get all web stories.
  getAllWebStories: () -> (vec WebStory) query;
  /// Authenticated users can get a single astro chart by id (only their own).
