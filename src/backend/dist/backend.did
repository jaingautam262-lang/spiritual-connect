service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initializeAccessControl: () -> ();
  /// Admin-only: add a new bhajan entry.
  addBhajan: (entry: BhajanEntry) -> ();
  /// Admin-only: add a festival event.
  addFestivalEvent: (event: FestivalEvent) -> ();
  /// Admin or productManager: add a gemstone product.
  addGemstoneProduct: (entry: GemstoneProduct) -> ();
  /// Admin-only: add a new holy book entry.
  addHolyBookEntry: (entry: HolyBookEntry) -> ();
  /// Admin-only: add a new Jain encyclopedia article.
  addJainArticle: (article: JainEncyclopediaArticle) -> ();
  /// Admin-only: add a Jain Katha.
  addJainKatha: (katha: JainKatha) -> ();
  /// Admin-only: add a Jain Pathshala entry.
  addJainPathshalaEntry: (entry: JainPathshalaEntry) -> ();
  /// Admin-only: add a media player item.
  addMediaPlayerItem: (item: MediaPlayerItem) -> ();
  /// Public: subscribe to the newsletter. Returns error if email is empty or already subscribed.
  addNewsletterSubscription: (email: text, name: opt text, source: text) ->
   (variant {
      err: text;
      ok: NewsletterSubscription;
    });
  /// Admin-only: add a panchang city.
  addPanchangCity: (city: PanchangCity) -> ();
  /// Admin-only: add a new Pathshala lesson.
  addPathshalaLesson: (lesson: PathshalaLesson) -> ();
  /// Admin or productManager: add a personalised product.
  addPersonalisedProduct: (entry: PersonalisedProduct) -> ();
  /// Admin-only: add a new suktam entry.
  addSuktam: (entry: SuktamEntry) -> ();
  /// Authenticated users can submit a prasad delivery request for themselves.
  addUserPrasadDeliveryRequest: (request: PrasadDeliveryRequest) -> ();
  /// Admin-only: add a new vrat katha entry.
  addVratKatha: (entry: VratKathaEntry) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  /// Public: book a slot in a puja event. Returns booking reference or error.
  bookPujaEventSlot: (sankalp: SankalpInput) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Admin-only: create an astrologer profile.
  createAstrologerProfile: (profile: AstrologerProfile) -> ();
  /// Admin-only: create a blog article.
  createBlogArticle: (article: BlogArticle) -> ();
  /// Public: anyone can submit a consultation booking request (no login required).
  /// Returns the auto-generated booking reference ID.
  createBookingRequest: (fullName: text, email: text, phone: text, birthDate:
   text, birthTime: text, birthLocation: text, preferredDateTime: text,
   consultationMode: text, topic: text, specialQuestions: text) -> (text);
  /// Authenticated users can create a business name analysis for themselves.
  createBusinessNameRecord: ("record": BusinessNameRecord) -> ();
  /// Authenticated users can submit a chadhava offering for themselves.
  createChadhavaOffering: (offering: ChadhavaOffering) -> ();
  /// Authenticated users can create a Stripe checkout session (e.g. for payment).
  createCheckoutSession: (items: vec ShoppingItem, successUrl: text,
   cancelUrl: text) -> (text);
  /// Authenticated user: create a combined vedic reading. Returns the created entry.
  createCombinedVedicReading: (palmReadingId: text, birthDate: text,
   birthTime: text, birthPlace: text, lagnaSign: text, moonSign: text,
   sunSign: text, activeDasha: text, doshasJson: text, palmInsightsJson:
   text, combinedInsightsText: text, remediesText: text) ->
   (CombinedVedicReading);
  /// Authenticated users can book a consultation appointment for themselves.
  createConsultationAppointment: (appointment: ConsultationAppointment) -> ();
  /// Admin-only: create a devotional content entry.
  createDevotionalContent: (content: DevotionalContent) -> ();
  /// Authenticated users can create a numerology analysis for themselves.
  createNumerologyRecord: ("record": NumerologyRecord) -> ();
  /// Authenticated users can place an order for themselves.
  createOrder: (order: Order) -> ();
  /// Authenticated user: create a palm photo reading. Returns the created entry.
  createPalmPhotoReading: (photoUrl: text, handType: text, palmShape: 
   text, lineAnnotations: text, readingText: text, dominantLine: text,
   luckySigns: text) -> (PalmPhotoReading);
  /// Admin-only: create a new palmistry content entry. Returns the created entry.
  createPalmistryContent: (title: text, titleHi: text, category: text,
   lineOrPalmType: text, descriptionEn: text, descriptionHi: text,
   characteristicsEn: text, characteristicsHi: text, locationOnPalm: 
   text, benefitsEn: text, benefitsHi: text) -> (PalmistryContent);
  /// Admin or productManager: create a product.
  createProduct: (product: Product) -> ();
  /// Authenticated users can create a puja booking for themselves.
  createPujaBooking: (booking: PujaBooking) -> ();
  /// Admin-only: create a new puja event. Returns the generated id.
  createPujaEvent: (pujaName: text, pujaNameHindi: text, date: text, time:
   text, description: text, price: nat, slotsAvailable: nat, location: 
   text, deity: text, isActive: bool) -> (text);
  /// Admin-only: create a puja report for a completed booking.
  createPujaReport: (report: PujaReport) -> ();
  /// Admin-only: create a puja type.
  createPujaType: (pujaType: PujaType) -> ();
  /// Authenticated users can request a report for themselves.
  createReportRequest: (request: ReportRequest) -> ();
  /// Authenticated users can create a service booking for themselves. Returns the booking id.
  createServiceBooking: (booking: ServiceBooking) -> (text);
  /// Admin or productManager: create a new product sub-category. Returns the generated id.
  createSubCategory: (name: text, nameCode: text, autoCodePrefix: text) ->
   (text);
  /// Admin-only: create a temple entry.
  createTemple: (temple: Temple) -> ();
  /// Admin-only: create a new vastu content entry. Returns the created entry.
  createVastuContent: (title: text, titleHi: text, category: text,
   directionOrRoom: text, planetaryRuler: text, planetaryRulerHi: text,
   effectsEn: text, effectsHi: text, doshaEn: text, doshaHi: text,
   remediesEn: text, remediesHi: text, yantra: text, elementsInvolved: 
   text, tipsEn: text, tipsHi: text) -> (VastuContent);
  /// Authenticated user: create a vastu room check. Returns the created entry.
  createVastuRoomCheck: (floorPlanUrl: text, roomType: text, roomDimensions:
   text, entranceDirection: text, complianceScore: nat, issuesJson: text,
   remediesJson: text, elementBalance: text) -> (VastuRoomCheck);
  /// Admin-only: create a web story.
  createWebStory: (story: WebStory) -> ();
  /// Authenticated users can delete their own astro chart.
  deleteAstroChart: (id: text) -> (bool);
  /// Admin-only: delete a bhajan entry.
  deleteBhajan: (id: text) -> ();
  /// Admin-only: delete a blog article.
  deleteBlogArticle: (id: text) -> ();
  /// Authenticated user: delete a combined vedic reading they own. Returns true if deleted.
  deleteCombinedVedicReading: (id: text) -> (bool);
  /// Admin-only: delete a devotional content entry.
  deleteDevotionalContent: (id: text) -> ();
  /// Admin-only: delete a festival event.
  deleteFestivalEvent: (id: text) -> ();
