  saveAstroChart: (chart: AstroChart) -> ();
  /// Admin-only: save (create or replace) a calculator FAQ.
  saveCalculatorFAQ: (faq: CalculatorFAQ) -> ();
  /// Save / update the calling user's own profile.
  saveCallerUserProfile: (profile: UserProfile) -> ();
  /// Authenticated users can save a kundali match result for themselves.
  saveKundaliMatch: (match: KundaliMatchInput) -> (text);
  /// Authenticated users can save a palmistry reading for themselves.
  savePalmistryReading: (reading: PalmistryReading) -> ();
  /// Authenticated users can save their own virtual temple configuration.
  saveVirtualTempleConfig: (config: VirtualTempleConfig) -> ();
  /// Admin-only: grant productManager role to a user.
  setProductManagerRole: (userId: principal) -> ();
  /// Admin-only: set the Stripe configuration.
  setStripeConfiguration: (config: StripeConfiguration) -> ();
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  /// Public: unsubscribe from the newsletter (sets isActive = false).
  unsubscribeNewsletter: (email: text) -> (variant {
                                             err: text;
                                             ok;
                                           });
  /// Admin-only: update an existing bhajan entry.
  updateBhajan: (entry: BhajanEntry) -> ();
  /// Admin-only: update an existing blog article.
  updateBlogArticle: (article: BlogArticle) -> ();
  /// Admin-only: update the status of a booking request.
  updateBookingRequestStatus: (refId: text, status: text) -> ();
  /// Admin-only: update an existing calculator FAQ by id.
  updateCalculatorFAQ: (id: text, faq: CalculatorFAQ) -> ();
  /// Authenticated user: update an existing combined vedic reading they own. Returns updated entry or null.
  updateCombinedVedicReading: (id: text, palmReadingId: text, birthDate:
   text, birthTime: text, birthPlace: text, lagnaSign: text, moonSign: 
   text, sunSign: text, activeDasha: text, doshasJson: text,
   palmInsightsJson: text, combinedInsightsText: text, remediesText: 
   text) -> (opt CombinedVedicReading);
  /// Admin-only: update appointment status and notes.
  updateConsultationAppointment: (id: text, status: text, notes: text) -> ();
  /// Admin-only: update an existing devotional content entry.
  updateDevotionalContent: (content: DevotionalContent) -> ();
  /// Admin-only: update an existing festival event.
  updateFestivalEvent: (event: FestivalEvent) -> ();
  /// Admin or productManager: update a gemstone product (full replace by sku).
  updateGemstoneProduct: (entry: GemstoneProduct) -> ();
  /// Admin-only: update an existing holy book entry.
  updateHolyBookEntry: (entry: HolyBookEntry) -> ();
  /// Admin-only: update an existing Jain encyclopedia article.
  updateJainArticle: (article: JainEncyclopediaArticle) -> ();
  /// Admin-only: update an existing Jain Katha.
  updateJainKatha: (katha: JainKatha) -> ();
  /// Admin-only: update an existing Jain Pathshala entry.
  updateJainPathshalaEntry: (entry: JainPathshalaEntry) -> ();
  /// Admin-only: update order payment status.
  updateOrderPaymentStatus: (id: text, paymentStatus: text,
   stripePaymentIntentId: text) -> ();
  /// Authenticated user: update an existing palm photo reading they own. Returns updated entry or null.
  updatePalmPhotoReading: (id: text, photoUrl: text, handType: text,
   palmShape: text, lineAnnotations: text, readingText: text, dominantLine:
   text, luckySigns: text) -> (opt PalmPhotoReading);
  /// Admin-only: update an existing palmistry content entry. Returns the updated entry or null if not found.
  updatePalmistryContent: (id: text, title: text, titleHi: text, category:
   text, lineOrPalmType: text, descriptionEn: text, descriptionHi: text,
   characteristicsEn: text, characteristicsHi: text, locationOnPalm: 
   text, benefitsEn: text, benefitsHi: text) -> (opt PalmistryContent);
  /// Admin-only: update an existing panchang city.
  updatePanchangCity: (city: PanchangCity) -> ();
  /// Admin-only: update an existing Pathshala lesson.
  updatePathshalaLesson: (id: text, lesson: PathshalaLesson) -> ();
  /// Admin or productManager: update a personalised product (full replace).
  updatePersonalisedProduct: (entry: PersonalisedProduct) -> ();
  /// Admin-only: update the status of a prasad delivery request.
  updatePrasadDeliveryStatus: (id: text, status: text) -> ();
  /// Admin or productManager: replace a product entirely (backward-compatible full update).
  updateProduct: (product: Product) -> ();
  /// Admin or productManager: partial update — only supplied fields are changed.
  /// Admin or productManager: partial update — only supplied fields are changed.
  updateProductFields: (id: text, updates: ProductUpdateRequest) -> ();
  /// Admin or productManager: update stock for a product.
  updateProductStock: (id: text, stock: nat) -> ();
  /// Admin or productManager: update only the variants array for a product (gemstone weight variants).
  updateProductVariants: (id: text, variants: vec ProductVariant) -> ();
  /// Admin-only: update an existing puja event. Returns true if updated.
  updatePujaEvent: (id: text, pujaName: text, pujaNameHindi: text, date:
   text, time: text, description: text, price: nat, slotsAvailable: nat,
   location: text, deity: text, isActive: bool) -> (bool);
  /// Admin-only: update an existing puja report.
  updatePujaReport: (id: text, report: PujaReport) -> ();
  /// Admin-only: update an existing puja type.
  updatePujaType: (pujaType: PujaType) -> ();
  /// Admin-only: update report status and content.
  updateReportRequest: (id: text, status: text, content: text) -> ();
  /// Admin-only: update the status of a service booking.
  updateServiceBookingStatus: (id: text, status: text) -> ();
  /// Admin or productManager: update a product sub-category. Returns true if updated.
  updateSubCategory: (id: text, name: text, nameCode: text, autoCodePrefix:
   text) -> (bool);
  /// Admin-only: update an existing suktam entry.
  updateSuktam: (entry: SuktamEntry) -> ();
  /// Admin-only: update an existing vastu content entry. Returns the updated entry or null if not found.
  updateVastuContent: (id: text, title: text, titleHi: text, category: 
   text, directionOrRoom: text, planetaryRuler: text, planetaryRulerHi: 
   text, effectsEn: text, effectsHi: text, doshaEn: text, doshaHi: text,
   remediesEn: text, remediesHi: text, yantra: text, elementsInvolved: 
   text, tipsEn: text, tipsHi: text) -> (opt VastuContent);
  /// Authenticated user: update an existing vastu room check they own. Returns updated entry or null.
  updateVastuRoomCheck: (id: text, floorPlanUrl: text, roomType: text,
   roomDimensions: text, entranceDirection: text, complianceScore: nat,
   issuesJson: text, remediesJson: text, elementBalance: text) ->
   (opt VastuRoomCheck);
  /// Admin-only: update an existing vrat katha entry.
  updateVratKatha: (entry: VratKathaEntry) -> ();
  /// Admin-only: update an existing web story.
  updateWebStory: (story: WebStory) -> ();
}
