  isProductManager: () -> (bool) query;
  /// Public: check whether Stripe has been configured.
  isStripeConfigured: () -> (bool) query;
  /// Authenticated users can add funds to their own wallet (recharge).
  rechargeWallet: (userId: principal, amount: float64, transaction:
   WalletTransaction) -> ();
